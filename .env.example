# WhatsApp Cloud API Configuration
# Copy this file to .env and fill in your actual values

# Server port
PORT=3000

# WhatsApp Access Token (get from Meta Developer Portal)
WHATSAPP_TOKEN=YOUR_PERMANENT_ACCESS_TOKEN_HERE

# Phone Number ID (get from Meta Developer Portal)
PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID_HERE

# Webhook verification token (you create this - any random string)
VERIFY_TOKEN=my_secure_verify_token_12345
